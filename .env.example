# MiniMax TTS（语音合成）
MINIMAX_API_KEY=
MINIMAX_VOICE_ID=

# DeepSeek（对话 + 情绪结构化判断）
DEEPSEEK_API_KEY=

# 可选覆盖项（一般无需配置）
# XIAOXIAOWO_DB_PATH=./data/xiaoxiaowo.sqlite
# XIAOXIAOWO_STATIC_DIR=./api/static
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# MINIMAX_BASE_URL=https://api.minimax.io
# MINIMAX_TTS_SPEED=1.25   # 合成语速，范围 0.5–2.0；修改后需重启 API 服务
# XIAOXIAOWO_DELETE_AFTER_SECONDS=300   # 关闭 H5 后的数据删除倒计时（设定 §11）
# FUNASR_MODEL_DIR=./data/models/SenseVoiceSmall   # 本地 FunASR 模型目录（SenseVoiceSmall，约 936MB，模型文件在 data/ 下不入 git）；不配置则 STT 返回 501 让前端回退文字。STT 依赖见 api/requirements-stt.txt
